# Python bytecode
__pycache__/
*.pyc

# Virtual environment, created by `make install`
.amazeing_env/

# MLX library, cloned and built by `make install`
.mlx_build/

# Build artifacts, created by `make build` (python -m build)
build/
dist/
*.egg-info/

# Lint / type-check caches
.mypy_cache/
.pytest_cache/

# Generated maze output files (actual name depends on OUTPUT_FILE in the
# config, these are just the ones actually used while developing this)
maze.txt
output_maze.txt

# Windows "Mark of the Web" metadata, left behind on files downloaded
# through a Windows browser
*:Zone.Identifier
